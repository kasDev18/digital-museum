{
  "name": "digital-museum",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8084",
    "dev:turbo": "next dev --turbopack -p 8084",
    "prebuild": "pnpm lint",
    "build": "next build",
    "start": "next start -p 8084",
    "lint:next": "next lint",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx,css}\"",
    "lint:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx,css}\"",
    "check": "pnpm lint && pnpm ts:check && pnpm format",
    "ts:check": "tsc --noEmit --pretty",
    "ts:watch": "tsc --watch",
    "format": "prettier --check \"**/*.{js,jsx,ts,tsx,css,json,md,yml,yaml}\"",
    "format:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,css,json,md,yml,yaml}\""
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
